    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>x86</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Debug|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\x64\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)' == 'Release|x64'">
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\x64\Release\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="KeyHunterGui.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="SigPatterns.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.config" />
    <None Include="tools\analyze.py" />
  </ItemGroup>
  <ItemGroup>
    <!-- build the tools first, then ship their fresh binaries instead of stale copies -->
    <ProjectReference Include="..\KeyDiag\KeyDiag.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\KeyHunter\KeyHunter.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\KeyHunterExe\KeyHunterExe.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\KeyHunterExe64\KeyHunterExe64.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <Target Name="CopyKeyHunterTools" AfterTargets="Build">
    <ItemGroup>
      <ToolFiles Include="$(ProjectDir)tools\*.*" />
      <BuiltToolFiles Include="$(ProjectDir)..\KeyDiag\bin\$(Configuration)\KeyDiag.exe" />
      <BuiltToolFiles Include="$(ProjectDir)..\KeyHunter\bin\$(Configuration)\KeyHunter.exe" />
      <BuiltToolFiles Include="$(ProjectDir)..\KeyHunterExe\bin\$(Configuration)\KeyHunterExe.exe" />
      <BuiltToolFiles Include="$(ProjectDir)..\KeyHunterExe64\bin\$(Configuration)\KeyHunterExe64.exe" />
    </ItemGroup>
    <Copy SourceFiles="@(ToolFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(BuiltToolFiles)" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="false" Condition="Exists('%(BuiltToolFiles.FullPath)')" />
  </Target>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>